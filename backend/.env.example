# =============================================================================
# HOTEL MONTSERRAT S.A.S. - VARIABLES DE ENTORNO (EJEMPLO DE PRODUCCIÓN)
# NOTA: En producción, todas las llaves secretas deben tener >= 256 bits de entropía
# =============================================================================

PORT=4000
NODE_ENV=development

# Seguridad de Red y CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173

# Criptografía y Sesiones
COOKIE_SECRET=montserrat_cookie_secret_key_prod_entropy_32_bytes_random_value
PASSWORD_PEPPER=montserrat_pepper_defense_in_depth_system_entropy_key_prod_2026

# Tiempos de Expiración de Sesión (Validación en Servidor)
SESSION_INACTIVITY_TIMEOUT_MINUTES=20
SESSION_MAX_DURATION_HOURS=12

# Anti Fuerza Bruta (Backoff Exponencial en Servidor)
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_PENALTY_SECONDS=30

# Base de Datos Relacional
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_montserrat_db
DB_USER=hotel_admin
DB_PASSWORD=change_this_password_in_production
